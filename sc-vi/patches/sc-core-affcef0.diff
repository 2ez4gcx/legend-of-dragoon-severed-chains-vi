+      int wordWidth = 0;
+      while(i < line.size() && line.getInt(i) != SPACE) {
+        wordWidth += widths[i];
+        i++;
+      }
+
+      if(start == i) {
+        break;
+      }
+
+      if(!lineEmpty && width + spaceWidth + wordWidth > maxWidth) {
+        out.add(LINE);
+        width = 0;
+        lineEmpty = true;
+      }
+
+      if(!lineEmpty) {
+        out.add(SPACE);
+        width += spaceWidth;
+      }
+
+      for(int k = start; k < i; k++) {
+        out.add(line.getInt(k));
+      }
+
+      width += wordWidth;
+      lineEmpty = false;
+    }
