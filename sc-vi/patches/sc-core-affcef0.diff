+    if(config.mode != RemasterConfig.Mode.FULL) {
+      noAtlas = "geometry mode";
+    } else if(tw != 0 || th != 0) {
+      noAtlas = "texture override";
+    } else if(model.clutAnimations_a4 != null) {
