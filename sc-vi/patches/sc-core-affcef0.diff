+    }
+
+    state.init();
+    final RemasterModel result = new RemasterModel(name, key, tables, sets, state);
+    previous = result;
+    return result;
+  }
+
+  private static int count(final boolean[] flags) {
+    int n = 0;
+    for(final boolean f : flags) {
+      if(f) {
+        n++;
+      }
+    }
+    return n;
+  }
