+          final boolean[][] liveByVariant = new boolean[variantCount][];
+          for(int v = 0; v < variantCount; v++) {
+            if(atlas[v] != null) {
+              liveByVariant[v] = liveModel.clone();
+              final int[] fh = lrm.variants[v].faceHash;
+              for(int k = 0; k < fh.length; k++) {
