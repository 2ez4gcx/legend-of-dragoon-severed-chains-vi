+  /**
+   * [sc-vi] Auto frame skip. The game logic runs exactly once per drawn frame with no catch-up, so a GPU that can't keep up
+   * (phones at high resolution) slows the whole game down. This mirrors the window Action's schedule (Action.updateTimer,
+   * including its "more than 2 ticks behind" reset) and, when a frame starts more than one tick late, runs it without drawing,
+   * at most MAX_LAG_SKIP frames in a row. A machine that keeps up never skips.
+   */
+  private boolean updateLagSkip() {
+    final long now = System.nanoTime();
+    final long tick = 1_000_000_000L / Math.max(1, this.window.getFpsLimit());
+
+    if(this.lagSchedule == 0L) {
+      this.lagSchedule = now;
+    }
+
+    final long late = now - this.lagSchedule;
+    this.lagSchedule += tick;
+
+    if(now - this.lagSchedule > tick * 2) {
+      this.lagSchedule = now + tick;
+    }
+
+    final boolean skip = late > tick && this.lagSkipped < MAX_LAG_SKIP && this.frameSkipIndex == 0 && !this.paused && !this.togglePause && CONFIG.getConfig(AUTO_FRAME_SKIP_CONFIG.get());
