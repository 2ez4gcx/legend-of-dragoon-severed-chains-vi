+    static final long FAST_WINDOW = 2_000_000_000L;
+    static final long SLOW_INTERVAL = 1_000_000_000L;
+    static final int MAX_TRIPS = 3;
+
+    final String name;
+    final String key;
+    final FaceVerify verify;
+    final boolean[] liveModel;
