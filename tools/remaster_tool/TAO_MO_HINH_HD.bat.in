@echo off
chcp 65001 >nul
cd /d "%~dp0"
rem Tạo mô hình HD — công cụ TUỲ CHỌN của bản Việt hoá The Legend of Dragoon cho Severed Chains.
rem Mở cửa sổ công cụ (Java Swing, vi\remaster\lodsc-remaster.jar) chạy bằng Java 25 mà Severed Chains đã tải vào jdk25\.
rem Mẫu cho tools/make_release.py: thay @SC_JAR@ = lod-game-<commit SC>.jar và @GSON_JAR@ = tên jar gson trong libs\
rem (ví dụ gson-2.13.2.jar), rồi ghi ra TAO_MO_HINH_HD.bat dạng UTF-8 (không BOM), xuống dòng CRLF.
rem %CD% chỉ dùng trong dấu nháy (thư mục có "&" sẽ làm cmd tách lệnh). Chính JDK không khởi động được khi đường dẫn
rem của nó có ";" ("Unable to load jimage library") hoặc ký tự ngoài bảng mã ANSI của Windows (ví dụ "ơ", "ử" trên
rem Windows tiếng Anh: "could not find java.dll") -> thử "java -version" trước để báo rõ thay vì hộp lỗi của javaw.
rem Đã thử: thư mục có "&", "^", "!", "( )" chạy được; có ";" hoặc "ơ ử" -> nhánh JAVA_PATH.

if not exist "@SC_JAR@" goto WRONG_SC
if not exist "jdk25\bin\javaw.exe" goto NO_JAVA
if not exist "jdk25\bin\java.exe" goto NO_JAVA
if not exist "vi\remaster\lodsc-remaster.jar" goto NO_TOOL
if not exist "vi\remaster\pins.json" goto NO_TOOL
if not exist "libs\@GSON_JAR@" goto NO_TOOL
"jdk25\bin\java.exe" -version >nul 2>&1
if errorlevel 1 goto JAVA_PATH

start "" "jdk25\bin\javaw.exe" -Dfile.encoding=UTF-8 -cp "vi/remaster/lodsc-remaster.jar;libs/@GSON_JAR@" vn.lodsc.remaster.Tool
exit /b 0

:WRONG_SC
echo Không thấy @SC_JAR@.
echo Đây không phải thư mục của gói Việt hoá, hoặc Severed Chains đã được cập nhật (nút Update).
echo Hãy giải nén lại gói Việt hoá vào thư mục mới.
pause
exit /b 1

:NO_JAVA
echo Chưa có Java (jdk25).
echo Hãy chạy launch-vi.bat một lần trước (tự tải Java và giải nén đĩa, chờ tới màn tựa), rồi mở lại file này.
pause
exit /b 1

:JAVA_PATH
echo Java trong jdk25\ không chạy được từ thư mục này:
echo "%CD%"
echo Thường do đường dẫn thư mục game có dấu chấm phẩy (;) hoặc chữ có dấu mà Windows không đọc được bằng bảng mã
echo cũ (ANSI) — khi đó cả game cũng không chạy được.
echo Hãy chuyển thư mục game sang đường dẫn chỉ có chữ không dấu, ví dụ D:\Games\LoD, rồi chạy lại.
pause
exit /b 1

:NO_TOOL
echo Thiếu vi\remaster\lodsc-remaster.jar, vi\remaster\pins.json hoặc libs\@GSON_JAR@.
echo Hãy giải nén lại gói Việt hoá.
pause
exit /b 1
